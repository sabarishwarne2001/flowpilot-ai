# Servabo website — build settings. Every value has a default in src/config/site.ts; set one only
# to change it. On Cloudflare Pages these are "Environment variables" (docs/website/DEPLOY.md).

# Where the website lives (canonical URLs, sitemap, Open Graph). Fallback domain: https://getservabo.com
PUBLIC_SITE_URL=https://servabo.app
# Where the app lives (Sign in, Start free trial). Fallback: https://app.getservabo.com
PUBLIC_APP_URL=https://app.servabo.app
# The public contact address (switch to support@servabo.app once email forwarding works).
PUBLIC_CONTACT_EMAIL=sabarishwarne@gmail.com
# Optional. When set, the contact page (and only the contact page) shows it.
PUBLIC_SUPPORT_PHONE=
