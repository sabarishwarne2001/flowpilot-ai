---
import Logo from "./Logo.astro";
import { APP, NAV } from "../config/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (href: string, match?: string) => path === href || (match ? path.startsWith(match) : false);
---
<header class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur supports-[backdrop-filter]:bg-background/70">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded-md focus:bg-card focus:px-3 focus:py-2 focus:text-sm focus:shadow-elevation-2">Skip to content</a>
  <div class="page flex h-16 items-center gap-6">
    <a href="/" class="shrink-0" aria-label="Servabo home">
      <Logo class="h-7 w-auto" />
    </a>
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={current(item.href, "match" in item ? item.match : undefined) ? "page" : undefined}
              class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground"
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <button type="button" data-theme-toggle class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-accent hover:text-foreground" aria-label="Switch theme" aria-pressed="false">
        <svg viewBox="0 0 24 24" class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"/></svg>
        <svg viewBox="0 0 24 24" class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"/></svg>
      </button>
      <a href={APP.signIn} class="hidden rounded-lg px-3 py-2 text-sm font-semibold text-foreground hover:bg-accent sm:inline-flex">Sign in</a>
      <a href={APP.register} class="btn-primary !min-h-[2.5rem] !px-4 !text-sm">Start free trial</a>
      <details class="group relative md:hidden">
        <summary class="inline-flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg text-foreground hover:bg-accent [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg viewBox="0 0 24 24" class="h-5 w-5 group-open:hidden" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
          <svg viewBox="0 0 24 24" class="hidden h-5 w-5 group-open:block" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/></svg>
        </summary>
        <nav aria-label="Main (mobile)" class="absolute right-0 top-12 w-64 rounded-xl border border-border bg-popover p-2 shadow-elevation-3">
          <ul>
            {NAV.map((item) => (
              <li><a href={item.href} class="block rounded-md px-3 py-2.5 text-sm font-medium text-foreground hover:bg-accent">{item.label}</a></li>
            ))}
            <li class="mt-1 border-t border-border pt-1"><a href="/about" class="block rounded-md px-3 py-2.5 text-sm font-medium text-foreground hover:bg-accent">About</a></li>
            <li><a href="/contact" class="block rounded-md px-3 py-2.5 text-sm font-medium text-foreground hover:bg-accent">Contact</a></li>
            <li><a href={APP.signIn} class="block rounded-md px-3 py-2.5 text-sm font-semibold text-foreground hover:bg-accent">Sign in</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
