---
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";

const topics = [
  { subject: "Question about Servabo", title: "Questions before you sign up", body: "What you want Servabo to do, the kind of documents you handle, and roughly how many a month." },
  { subject: "Support request", title: "Help with your account", body: "Your organization's name, the page you were on, what you did, what happened and what you expected. A screenshot helps. Never send a password." },
  { subject: "Billing question", title: "Billing, refunds and cancellations", body: "Your organization's name and the email on the subscription. For a refund, the date and amount of the payment (see the refund policy)." },
  { subject: "Enterprise yearly agreement", title: "An Enterprise yearly agreement", body: "Your company's name, the number of seats and the start date you have in mind." },
  { subject: "Security report", title: "A security issue", body: "What you found and how to reproduce it. See the security page." },
  { subject: "Privacy request", title: "Your personal data", body: "Access, correction, export or deletion of your data, or a question for the grievance officer named in the privacy policy." },
];
---
<Base title="Contact" description={`Contact Servabo at ${SITE.contactEmail}. We reply within ${SITE.responseTime}.`}>
  <section class="page pt-16 sm:pt-20" aria-labelledby="contact">
    <p class="eyebrow">Contact</p>
    <h1 id="contact" class="display mt-4 max-w-4xl">Write to us. A person answers.</h1>
    <div class="mt-10 grid gap-6 lg:grid-cols-[1.1fr_1fr]">
      <div class="sheet-fold p-8">
        <p class="text-sm text-muted-foreground">Email</p>
        <p class="mt-2 break-words text-2xl font-semibold"><a class="link" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
        <p class="mt-6 text-sm text-muted-foreground">Response time</p>
        <p class="mt-1 text-lg font-medium">Within {SITE.responseTime} (Monday to Friday, India time).</p>
        {SITE.supportPhone && (
          <>
            <p class="mt-6 text-sm text-muted-foreground">Phone</p>
            <p class="mt-1 text-lg font-medium"><a class="link" href={`tel:${SITE.supportPhone.replace(/[^+\d]/g, "")}`}>{SITE.supportPhone}</a></p>
          </>
        )}
      </div>
      <div class="sheet p-8">
        <h2 class="h3">Who you are writing to</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">{SITE.operator.name}, trading as Servabo, {SITE.operator.country}. Payments and invoices: {SITE.merchantOfRecord}, our merchant of record.</p>
        <p class="mt-3 leading-relaxed text-muted-foreground">The email above works for everything: questions, support, billing, privacy and security.</p>
      </div>
    </div>
  </section>

  <section class="page mt-16" aria-labelledby="include">
    <h2 id="include" class="h2">What to include</h2>
    <ul class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {topics.map((t) => (
        <li class="sheet p-6">
          <h3 class="font-semibold">{t.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{t.body}</p>
          <a class="link mt-4 inline-block text-sm" href={`mailto:${SITE.contactEmail}?subject=${encodeURIComponent(t.subject)}`}>Email: {t.subject}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>
