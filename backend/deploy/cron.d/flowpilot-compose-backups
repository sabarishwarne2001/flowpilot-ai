SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""

# F-006. Backups for a Docker Compose host. Install THIS file instead of flowpilot-backups
# (which drives the host-Python backup floor). Also install flowpilot-sweepers next to it,
# and put these in /etc/flowpilot/sweepers.env (see docs/RUNBOOK.md, "Scheduled jobs"):
#
#   FLOWPILOT_RUNNER="docker compose -f /srv/flowpilot/backend/docker-compose.prod.yml --env-file /srv/flowpilot/backend/.env.production run --rm --no-deps -T -e SERVICE_ROLE=sweeper worker-light python"
#   FLOWPILOT_BACKUP_KEY_FILE=/etc/flowpilot/backup.key        # chmod 600; keep a copy OFF this host
#   FLOWPILOT_BACKUP_DIR=/srv/flowpilot/backups
#   FLOWPILOT_BACKUP_MIRROR_CMD='aws s3 cp "$1" s3://YOUR-BUCKET/flowpilot/'   # or rclone/mc; optional but strongly advised
#
#   FLOWPILOT_LOG_DIR=/srv/flowpilot/logs                     # must exist and belong to flowpilot
#   HEARTBEAT_BASE=https://hc-ping.com                        # a dead-man's switch: a free Healthchecks.io
#   HEARTBEAT_UUID_COMPOSE_BACKUP=<check uuid>                #   check per job emails you when a run fails
#   HEARTBEAT_UUID_COMPOSE_RESTORE_DRILL=<check uuid>         #   or does not happen at all
#
# The flowpilot user must be in the docker group. Nightly: an encrypted, verified dump.
# Weekly: restore the newest one into a scratch database and time it. A backup nobody has
# restored is a hypothesis. Output goes to the log directory, never to /dev/null (MAILTO is
# empty, so anything printed and not logged would be lost).
11 2 * * *  flowpilot  set -a; . /etc/flowpilot/sweepers.env; set +a; /srv/flowpilot/backend/deploy/bin/flowpilot-compose-backup >> "${FLOWPILOT_LOG_DIR:-/srv/flowpilot/logs}/compose_backup.log" 2>&1
37 4 * * 0  flowpilot  set -a; . /etc/flowpilot/sweepers.env; set +a; /srv/flowpilot/backend/deploy/bin/flowpilot-compose-restore-drill >> "${FLOWPILOT_LOG_DIR:-/srv/flowpilot/logs}/compose_restore_drill.log" 2>&1
# N-017: the API answers its public readiness check (alerts through HEARTBEAT_UUID_UPTIME).
* * * * *  flowpilot  set -a; . /etc/flowpilot/sweepers.env; set +a; /srv/flowpilot/backend/deploy/bin/flowpilot-uptime-heartbeat >> "${FLOWPILOT_LOG_DIR:-/srv/flowpilot/logs}/uptime.log" 2>&1
