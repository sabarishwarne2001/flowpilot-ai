# =============================================================================
# FlowPilot AI — backend/.env.example
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# start_dev.sh / start_dev.ps1 copy this file for you and generate the secrets
# that are blank below (JWT, peppers, Fernet key, reranker token).
#
# Every name here is read by the application (app/core/config.py), by
# docker-compose.yml, or by a script named next to it. A variable that nothing
# reads is silently ignored, so do not add names that are not listed here
# without checking app/core/config.py first.
# =============================================================================

# --- 1. Project metadata & server runtime ---
PROJECT_NAME=FlowPilot AI
APP_VERSION=1.0.0
API_TITLE=FlowPilot AI Core API
# development | test | staging | production (staging and production refuse to
# start with an unsafe configuration; see .env.production.template).
ENVIRONMENT=development
# web, worker-light, worker-ocr, worker-enrich, worker-relay, worker-delivery,
# worker-stripe, sweeper, cron or migrate. Decides this process's pool size.
SERVICE_ROLE=web
API_V1_STR=/api/v1
LOG_LEVEL=INFO
# text = one readable line per event; json = one JSON object per line.
LOG_FORMAT=text
HOST=0.0.0.0
PORT=8000

# --- 2. Frontend / CORS ---
# The address put in invitation, verification and password-reset emails.
# start_dev.sh / start_dev.ps1 run Vite on 5173; plain `npm run dev` uses 3000.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# --- 3. Database (PostgreSQL 16 + pgvector) ---
# docker-compose.yml creates the database with these same values.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flowpilot

# Read replica. Leave unset for single-node deployments and CI: the reader
# engine then points at the writer and every route behaves as before.
# DATABASE_REPLICA_URL=postgresql://flowpilot:flowpilot@db-replica:5432/flowpilot
DATABASE_REPLICA_ENFORCE_READ_ONLY=true

# --- 4. Redis: cache, rate limits, idempotency (ARCH-08) ---
# Local Redis has no password. Production sets REDIS_PASSWORD instead and the
# compose file builds the URL (see .env.production.template).
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
# Sign-in attempts per client address per 5 minutes (N-018).
RATE_LIMIT_LOGIN_IP_PER_5MIN=20
TRUSTED_PROXY_HOPS=0
# Set true only after the production ingress hop count has been verified end
# to end. Until then, tenants cannot enable IP pinning.
TRUSTED_PROXY_HOPS_CONFIRMED=false

# --- 5. Authentication, passwords & sessions (SEC-1, ARCH-03) ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=14
# Sign in again 12 hours after signing in, and after 30 idle minutes. 0 = off.
SESSION_ABSOLUTE_LIFETIME_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_REUSE_GRACE_SECONDS=10
SESSION_CHAIN_WALK_LIMIT=16

# Argon2id password hashing parameters (SEC-1)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
AUTH_LOGIN_MIN_DURATION_MS=250

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
IDENTITY_TOKEN_MAX_PER_WINDOW=5
IDENTITY_TOKEN_WINDOW_MINUTES=60

# --- 6. Cryptographic peppers & MultiFernet encryption keys (ARCH-07, ARCH-08, ARCH-16) ---
# In development and test you may leave these three blank: the app then derives
# a private value from YOUR JWT_SECRET_KEY, so nothing public is ever the key.
# (Changing JWT_SECRET_KEY then also changes them, which invalidates API keys
# and secrets stored in your local database.) In production and staging they
# are REQUIRED, must all differ, and the app refuses to start without them
# (see .env.production.template).
# Generate with: openssl rand -hex 32
API_KEY_PEPPER=
REDIS_IDENTITY_PEPPER=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated, newest key first to support rotation.
EMAIL_ENCRYPTION_KEYS=

# --- 7. Platform SMTP relay (invitations, verification, password reset) ---
# NONE | TLS | SSL. Gmail: smtp.gmail.com, 587, TLS, an App Password, and a
# FROM address equal to the Gmail account (Gmail rewrites any other).
PLATFORM_SMTP_HOST=smtp.yourprovider.com
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USERNAME=apikey
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_ENCRYPTION=TLS
PLATFORM_SMTP_FROM_EMAIL=noreply@flowpilot.ai
PLATFORM_SMTP_FROM_NAME=FlowPilot AI

# --- 8. Object storage (ARCH-10) ---
# local: writes to UPLOAD_DIR on disk
# minio: the S3-compatible container from docker-compose.yml
# s3:    AWS S3          r2: Cloudflare R2 (no SSE header, region "auto")
STORAGE_BACKEND=minio
UPLOAD_DIR=uploads
STORAGE_QUARANTINE_DIR=uploads/quarantine
MAX_UPLOAD_SIZE=104857600
MAX_DOCUMENT_PAGES=500
SCRUB_UPLOAD_METADATA=true

# Required when STORAGE_BACKEND is minio, s3 or r2. The AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY spellings are accepted as aliases; prefer these.
S3_BUCKET=flowpilot-dev
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Development only: with no credentials above, fall back to the local MinIO
# defaults. Ignored (and refused) in staging and production.
S3_DEV_FALLBACK_CREDENTIALS=true

# --- 9. LLM providers & pgvector embeddings (ARCH-11, ARCH-12) ---
# groq | gemini. Set the platform key for the provider you use; tenants on
# Business and Enterprise can bring their own key instead (BYOK).
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-20b
GEMINI_MODEL_NAME=gemini-3.5-flash

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384
OCR_LANGUAGE=en
OCR_PROVIDER=paddleocr
ENABLE_TOKEN_TRACKING=true
# Test stubs instead of PaddleOCR / SentenceTransformers (no model download).
# For machines that cannot fetch the weights. Refused in production.
# ML_STUBS=true

# RAG & context allocation
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.20
RAG_MAX_CONTEXT_LENGTH=15000
DOCUMENT_FILTER_MARGIN=0.25
DOCUMENT_SCORE_TOP_K=3
DOCUMENT_CHUNK_PARTITIONS=16

# Reranker sidecar. Off for host development, the RUNBOOK's path (no sidecar
# on 127.0.0.1:8081, and every search would wait for its timeout). Running the
# whole stack with `docker compose up`? Set true: the sidecar runs there.
# docker-compose.yml refuses to start without the token, so keep one set.
RERANKER_ENABLED=false
RERANKER_URL=http://127.0.0.1:8081
# Generate with: openssl rand -hex 32
RERANKER_INTERNAL_TOKEN=

# --- 10. Automation engine (ARCH-13) ---
AUTOMATION_ENGINE_ENABLED=true
AUTOMATION_MAX_DEPTH=5
AUTOMATION_MAX_NODES=50
AUTOMATION_EXECUTION_TIMEOUT_S=120
AUTOMATION_VERIFICATION_AGENTS=2
AUTOMATION_AUTO_APPROVE_THRESHOLD=0.85

# --- 11. Enterprise identity: domains, SCIM, SAML / OIDC (ARCH-16) ---
DOMAIN_VERIFICATION_TXT_PREFIX=flowpilot-site-verification
DOMAIN_VERIFICATION_TOKEN_TTL_DAYS=30
DOMAIN_VERIFICATION_GRACE_DAYS=14
SCIM_TOKEN_TTL_DAYS=365
SCIM_TOKEN_ROTATION_OVERLAP_DAYS=7
SAML_CLOCK_SKEW_S=120
# The address identity providers send users back to. Empty: http://localhost:8000
# in development, FRONTEND_URL in staging and production (Caddy serves the API on
# the web app's host). Set it only when the API has a host of its own.
PUBLIC_API_URL=

# --- 12. Billing: Stripe transport (ARCH-14, ARCH-15) ---
# Test-mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRETS=
STRIPE_LIVEMODE=false

# --- 12b. Payment gateway selection & Dodo Payments (HARDENING-T1:D16) ---
# Exactly one gateway is live per deployment: STRIPE or DODO.
BILLING_GATEWAY=STRIPE
# Dodo test keys come from the Dodo dashboard in Test mode. Leave
# DODO_API_BASE empty: it follows DODO_LIVEMODE (test.dodopayments.com when
# false, live.dodopayments.com when true). A host that contradicts the mode
# is refused at startup.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_LIVEMODE=false
DODO_API_BASE=
# Product ids for purchasable add-ons (test and live ids differ).
DODO_ADDON_PRODUCT_CUSTOM_DOMAIN=
DODO_ADDON_PRODUCT_WAREHOUSE_SYNC=
# How Dodo bills a mid-cycle seat change.
BILLING_DODO_SEAT_PRORATION_MODE=prorated_immediately
# Gateway price ids for the three paid plans, read by scripts/seed_quota_tiers.py
# (Stripe price_... ids or Dodo product ids, for whichever gateway is live). The
# seed refuses a paid plan with no id. Test-mode and live-mode ids differ.
GATEWAY_PRICE_ID_DEVELOPER=
GATEWAY_PRICE_ID_BUSINESS=
GATEWAY_PRICE_ID_ENTERPRISE=

BILLING_DEFAULT_CURRENCY=USD
BILLING_SEAT_SYNC_ENABLED=true
BILLING_SEAT_PRORATION_BEHAVIOR=create_prorations
BILLING_REAUTH_WINDOW_S=300
BILLING_REAUTH_REQUIRED=true
BILLING_DUNNING_MAX_STEP=NOTIFY_3

# --- 13. Metering safety switch ---
# NEVER set false outside automated tests.
LLM_METERING_ENABLED=true

# --- 14. White-label & custom domains (ARCH-25) ---
CUSTOM_DOMAINS_ENABLED=false
PLATFORM_RESERVED_HOSTS=["flowpilot.ai","app.flowpilot.ai","api.flowpilot.ai"]
CUSTOM_DOMAIN_CHALLENGE_TTL_HOURS=168
CUSTOM_DOMAIN_MAX_PER_ORG=10
ACME_AGENT_URL=
ACME_CONTACT_EMAIL=
TLS_RENEWAL_WINDOW_DAYS=30
TLS_DEAD_MAN_DAYS=7

# --- 15. Host-Python backups (scripts/backup_floor.py) ---
# Only for deploy/cron.d/flowpilot-backups on a host without Docker. A Compose
# deployment uses FLOWPILOT_BACKUP_KEY_FILE in /etc/flowpilot/sweepers.env.
# Generate with: openssl rand -base64 32
# FLOWPILOT_BACKUP_KEY=
