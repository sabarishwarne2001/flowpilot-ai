{
  "name": "servabo-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Servabo's public website (servabo.app): static, built with Astro.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "typecheck": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "check": "npm run check:links && npm run check:html && npm run check:a11y",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "autoprefixer": "10.5.2",
    "chrome-launcher": "1.2.2",
    "html-validate": "11.16.1",
    "lighthouse": "13.5.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
