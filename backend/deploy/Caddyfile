# =============================================================================
# FlowPilot AI — Caddy ingress.
#
# Mounted read-only at /etc/caddy/Caddyfile by docker-compose.prod.yml.
# Caddy handles ACME itself: no certbot, no cron renewal, no manual steps.
#
# Two distinct TLS paths:
#
#   1. The platform host ({$APP_DOMAIN}) gets a normal ACME certificate at
#      startup.
#   2. Tenant custom domains (ARCH-25) get on-demand certificates, gated by
#      an ask endpoint. The gate is not optional — without it, anyone who
#      points a DNS record at this host can force Caddy to request a
#      certificate for a domain you do not control, and Let's Encrypt will
#      rate-limit the whole deployment.
# =============================================================================

{
    email {$ACME_CONTACT_EMAIL}

    # On-demand TLS asks the application before issuing. The endpoint must
    # return 200 only for a domain in `custom_domains` whose ownership
    # challenge has been satisfied.
    on_demand_tls {
        ask http://web:8000/api/v1/internal/tls/authorize
        # ARCH46-S1:caddy-current. `interval` / `burst` were removed from Caddy
        # (caddy:2-alpine refuses to start with them); the ask endpoint is the
        # control that decides which domains get a certificate.
    }

    servers {
        trusted_proxies static private_ranges
    }
}

# ---------------------------------------------------------------- platform ---

{$APP_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # F-044 / N-015. Enforced. It ran report-only first; the whole browser suite
        # (E2E_CSP=1 serves the bundle with this exact header, read from this file)
        # passes with it enforced and no violation. Uploaded PDFs render with pdf.js
        # (a blob: worker). Keep the custom-domain block below in step.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    @sse {
        path /api/v1/assistant/*/stream*
        path /api/v1/assistant/*/resume*
    }
    handle @sse {
        reverse_proxy web:8000 {
            flush_interval -1
            transport http {
                response_header_timeout 10m
            }
        }
    }

    # GATE 10.3 — the internal namespace is not published.
    handle /api/v1/internal/* {
        respond 404
    }

    # ARCH48-S1:ws-live-review. The live review channel is a WebSocket
    # (/api/v1/workspaces/{id}/review/collab/live). reverse_proxy passes the
    # Upgrade through by itself; what this block adds is lifetime: frames are
    # flushed as they arrive, and a config reload lets open reviewers' sockets
    # run on for up to five minutes instead of cutting every one of them at
    # once (they reconnect by themselves either way).
    @review_live path /api/v1/workspaces/*/review/collab/live
    handle @review_live {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
            flush_interval -1
            stream_close_delay 5m
        }
    }

    handle /api/* {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # ARCH-30 Tranche 1 (T4-F3) — SCIM on the platform host.
    #
    # `app.main` mounts the SCIM router at /scim/v2, at the application ROOT,
    # not under /api. Every block above matches /api/* only, so an IdP's
    # POST /scim/v2/Users fell through to the catch-all file server below and
    # was answered with index.html. SCIM worked in development only because
    # start_dev.ps1 talks to uvicorn directly with no ingress in front.
    handle /scim/v2/* {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /docs* {
        reverse_proxy web:8000
    }
    handle /openapi.json {
        reverse_proxy web:8000
    }

    handle {
        root * /srv/frontend
        @immutable path /assets/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-store"
        try_files {path} /index.html
        file_server
    }

    # ARCH46-S1:log-redaction. A calendar-feed or document-request token rides in
    # the path; the access log keeps the path without it (the app's own logs
    # do the same: public_route_registry.redact_path).
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri regexp "(/api/v1/public/(?:calendar-feeds|document-requests)/)[^/?#]+" "$1[redacted]"
                # ARCH48-S1:ws-log-redaction. The live review socket carries the
                # access token in its subprotocol list (a browser can set no
                # Authorization header on a WebSocket); Caddy redacts
                # Authorization by itself but not this header.
                request>headers>Sec-Websocket-Protocol delete
            }
        }
    }
}

# --------------------------------------------------- tenant custom domains ---

:443 {
    tls {
        on_demand
    }

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # N-015. The same app as the platform host, so the same enforced policy.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    # GATE 10.3 — internal namespace unreachable on custom domains
    handle /api/v1/internal/* {
        respond 404
    }

    # ARCH-30 Tranche 1 (T4-F3) — SCIM on tenant custom domains.
    #
    # `header_up Host {host}` is load-bearing: `scim_key` refuses a token whose
    # organization differs from the tenant this hostname resolves to, and
    # HostTenantMiddleware can only resolve the tenant if the Host survives.
    handle /scim/v2/* {
        reverse_proxy web:8000 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # ARCH48-S1:ws-live-review. The live review channel on a custom domain
    # (the Host survives, as for every /api route here).
    @review_live path /api/v1/workspaces/*/review/collab/live
    handle @review_live {
        reverse_proxy web:8000 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
            flush_interval -1
            stream_close_delay 5m
        }
    }

    handle /api/* {
        reverse_proxy web:8000 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        root * /srv/frontend
        @immutable path /assets/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-store"
        try_files {path} /index.html
        file_server
    }

    # ARCH46-S1:log-redaction. A calendar-feed or document-request token rides in
    # the path; the access log keeps the path without it (the app's own logs
    # do the same: public_route_registry.redact_path).
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri regexp "(/api/v1/public/(?:calendar-feeds|document-requests)/)[^/?#]+" "$1[redacted]"
                # ARCH48-S1:ws-log-redaction. The live review socket carries the
                # access token in its subprotocol list (a browser can set no
                # Authorization header on a WebSocket); Caddy redacts
                # Authorization by itself but not this header.
                request>headers>Sec-Websocket-Protocol delete
            }
        }
    }
}

http://{$APP_DOMAIN} {
    redir https://{$APP_DOMAIN}{uri} permanent
}
