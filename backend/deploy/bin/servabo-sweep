#!/usr/bin/env bash
set -uo pipefail
# >>> one-release names: Servabo was called FlowPilot until 2026-10-16. The old FLOWPILOT_*
# variables and /etc/flowpilot/ still work in this release (the new name wins when both are
# set), with one warning naming what to rename. Remove this block in the next release.
servabo_legacy_names() {
    local old new
    for old in $(compgen -v | grep '^FLOWPILOT_' || true); do
        new="SERVABO_${old#FLOWPILOT_}"
        [[ -z "${!new+x}" ]] && export "${new}=${!old}"
        [[ " ${SERVABO_LEGACY_SEEN:-} " == *" ${old} "* ]] && continue
        SERVABO_LEGACY_SEEN="${SERVABO_LEGACY_SEEN:-} ${old}"
        echo "warning: FlowPilot was renamed Servabo; rename ${old} to ${new} (the old name stops working in the next release)" >&2
    done
    if [[ -z "${SERVABO_SWEEPER_ENV:-}" && ! -e /etc/servabo/sweepers.env && -r /etc/flowpilot/sweepers.env ]]; then
        SERVABO_SWEEPER_ENV=/etc/flowpilot/sweepers.env
        echo "warning: FlowPilot was renamed Servabo; move /etc/flowpilot/ to /etc/servabo/" >&2
    fi
    return 0
}
servabo_legacy_names
# <<< one-release names

CONFIG_FILE="${SERVABO_SWEEPER_ENV:-/etc/servabo/sweepers.env}"
[[ -r "${CONFIG_FILE}" ]] && source "${CONFIG_FILE}"
servabo_legacy_names  # names the config file still spells the old way

SERVABO_ROOT="${SERVABO_ROOT:-/srv/servabo}"
SERVABO_VENV="${SERVABO_VENV:-${SERVABO_ROOT}/venv}"
SERVABO_LOG_DIR="${SERVABO_LOG_DIR:-/var/log/servabo}"
TEXTFILE_DIR="${TEXTFILE_DIR:-/var/lib/node_exporter/textfile_collector}"
LOCK_DIR="${LOCK_DIR:-/var/lock/servabo}"

if [[ $# -lt 1 ]]; then
    echo "usage: $(basename "$0") <arch07|identity|invitations|arch09|compliance|backup|restore-drill|extraction_memory|entities|cases|corroboration|obligations|erp_postings|process|revops|dr-heartbeat|base-backup|pitr-drill> [args...]" >&2
    exit 64
fi

NAME="$1"; shift

case "${NAME}" in
    arch07)      SCRIPT="scripts/sweep_arch07.py"      ; HEARTBEAT="${HEARTBEAT_UUID_ARCH07:-}"      ;;
    identity)    SCRIPT="scripts/sweep_identity.py"    ; HEARTBEAT="${HEARTBEAT_UUID_IDENTITY:-}"    ;;
    invitations) SCRIPT="scripts/sweep_invitations.py" ; HEARTBEAT="${HEARTBEAT_UUID_INVITATIONS:-}" ;;
    arch09)      SCRIPT="scripts/sweep_arch09.py"      ; HEARTBEAT="${HEARTBEAT_UUID_ARCH09:-}"      ;;
    compliance)  SCRIPT="scripts/sweep_compliance.py"  ; HEARTBEAT="${HEARTBEAT_UUID_COMPLIANCE:-}" ;;
    # ARCH41-S1:sweep-backup. The backup floor and its weekly restore drill
    # get the same lock, log, heartbeat and textfile metric as every sweeper.
    backup)        SCRIPT="scripts/backup_floor.py"  ; HEARTBEAT="${HEARTBEAT_UUID_BACKUP:-}"        ;;
    restore-drill) SCRIPT="scripts/restore_drill.py" ; HEARTBEAT="${HEARTBEAT_UUID_RESTORE_DRILL:-}" ;;
    # ARCH41-S2:sweep-extraction-memory. Nightly: merge layouts, learn and
    # promote rules, start and judge trials, withdraw what drifted.
    extraction_memory) SCRIPT="scripts/sweep_extraction_memory.py" ; HEARTBEAT="${HEARTBEAT_UUID_EXTRACTION_MEMORY:-}" ;;
    # ARCH42-S1:sweep-entities. Nightly: re-key, catch up, fit EM, re-resolve,
    # tidy. See app/services/entities/sweep.py.
    entities) SCRIPT="scripts/sweep_entities.py" ; HEARTBEAT="${HEARTBEAT_UUID_ENTITIES:-}" ;;
    # ARCH43-S1:sweep-cases. Nightly: expire document requests, re-evaluate
    # open cases. See scripts/sweep_cases.py.
    cases) SCRIPT="scripts/sweep_cases.py" ; HEARTBEAT="${HEARTBEAT_UUID_CASES:-}" ;;
    # ARCH45-S1:sweep-corroboration. Nightly: re-fingerprint completed
    # comparisons (STALE when a document changed), fail stuck runs, delete
    # superseded ones nobody reviewed. See scripts/sweep_corroboration.py.
    corroboration) SCRIPT="scripts/sweep_corroboration.py" ; HEARTBEAT="${HEARTBEAT_UUID_CORROBORATION:-}" ;;
    # ARCH46-S1:sweep-obligations. Hourly: move obligations to DUE_SOON /
    # OVERDUE at each workspace's local date and raise each alert once; link
    # late-resolved parties. See scripts/sweep_obligations.py.
    obligations) SCRIPT="scripts/sweep_obligations.py" ; HEARTBEAT="${HEARTBEAT_UUID_OBLIGATIONS:-}" ;;
    # ARCH47-S1:sweep-erp-postings. Every 10 minutes: auto-post approved
    # outcomes, re-enqueue due retries and expired leases, read SFTP
    # acknowledgements. See scripts/sweep_erp_postings.py.
    erp_postings) SCRIPT="scripts/sweep_erp_postings.py" ; HEARTBEAT="${HEARTBEAT_UUID_ERP_POSTINGS:-}" ;;
    # ARCH49-S1:sweep-process. Every 15 minutes: one process.sweep_workspace job
    # per enabled workspace and slot (the event log, SLA predictions, the
    # exception agent). See scripts/sweep_process.py.
    process) SCRIPT="scripts/sweep_process.py" ; HEARTBEAT="${HEARTBEAT_UUID_PROCESS:-}" ;;
    # ARCH50-S1:sweep-revops. Daily: contracts, invoices, promo reservations,
    # revenue snapshots, egress-refusal retention. See scripts/sweep_revops.py.
    revops) SCRIPT="scripts/sweep_revops.py" ; HEARTBEAT="${HEARTBEAT_UUID_REVOPS:-}" ;;
    # ARCH50-S1:sweep-dr. Point-in-time recovery (scripts/dr_pitr.py): the
    # heartbeat, the nightly base backup and the weekly timed PITR drill. The
    # WAL archiver itself is PostgreSQL's archive_command (dr_pitr.py archive-wal).
    dr-heartbeat) SCRIPT="scripts/dr_pitr.py" ; set -- heartbeat "$@" ; HEARTBEAT="" ;;
    base-backup)  SCRIPT="scripts/dr_pitr.py" ; set -- base-backup "$@" ; HEARTBEAT="${HEARTBEAT_UUID_BASE_BACKUP:-}" ;;
    pitr-drill)   SCRIPT="scripts/dr_pitr.py" ; set -- drill --from-archive --record "$@" ; HEARTBEAT="${HEARTBEAT_UUID_PITR_DRILL:-}" ;;
    *)
        echo "unknown sweeper: ${NAME}" >&2
        exit 64
        ;;
esac

mkdir -p "${SERVABO_LOG_DIR}" "${LOCK_DIR}"
LOG_FILE="${SERVABO_LOG_DIR}/sweep_${NAME}.log"
LOCK_FILE="${LOCK_DIR}/sweep_${NAME}.lock"

STARTED_AT="$(date -u +%s)"

{
    echo "=== $(date -u +%FT%TZ) | sweep ${NAME} | args: $* ==="
} >> "${LOG_FILE}"

MODULE="${SCRIPT%.py}"
MODULE="${MODULE//\//.}"

# F-006. On a Docker Compose host there is no Python venv on the host at all. Setting
# SERVABO_RUNNER (in sweepers.env) to a command that runs `python` inside the stack
# makes every sweep run in a container, for example:
#
#   SERVABO_RUNNER="docker compose -f /srv/servabo/backend/docker-compose.prod.yml \
#       --env-file /srv/servabo/backend/.env.production run --rm --no-deps -T \
#       -e SERVICE_ROLE=sweeper worker-light python"
#
# The runner receives `-m <module> <args>`; the host needs no checkout of the venv, only
# the compose files. Unset, the wrapper behaves exactly as before (host venv).
if [[ -n "${SERVABO_RUNNER:-}" ]]; then
    read -r -a RUNNER <<< "${SERVABO_RUNNER}"
    RUN_CMD=("${RUNNER[@]}" -m "${MODULE}" "$@")
else
    cd "${SERVABO_ROOT}/backend" || {
        echo "SWEEP_FAILED | ${NAME} | cannot cd to ${SERVABO_ROOT}/backend" >> "${LOG_FILE}"
        exit 1
    }
    RUN_CMD=(env SERVICE_ROLE=sweeper "${SERVABO_VENV}/bin/python" -m "${MODULE}" "$@")
fi

flock -w 0 "${LOCK_FILE}" \
    "${RUN_CMD[@]}" \
    >> "${LOG_FILE}" 2>&1
STATUS=$?

FINISHED_AT="$(date -u +%s)"
DURATION=$(( FINISHED_AT - STARTED_AT ))

OUTCOME="fail"
case "${STATUS}" in
    0)
        OUTCOME="ok"
        ;;
    3)
        if [[ "${NAME}" == "invitations" ]]; then
            OUTCOME="ok"
            echo "SWEEP_SKIPPED | ${NAME} | advisory lock held elsewhere" >> "${LOG_FILE}"
        fi
        ;;
    2)
        echo "SWEEP_BAD_ARGS | ${NAME} | argparse rejected: $*" >> "${LOG_FILE}"
        ;;
esac

if [[ -d "${TEXTFILE_DIR}" ]]; then
    TMP="$(mktemp "${TEXTFILE_DIR}/servabo_sweeper_${NAME}.XXXXXX")"
    {
        echo "# HELP servabo_sweeper_last_run_timestamp_seconds Unix time of the last completed run."
        echo "# TYPE servabo_sweeper_last_run_timestamp_seconds gauge"
        echo "servabo_sweeper_last_run_timestamp_seconds{sweeper=\"${NAME}\"} ${FINISHED_AT}"
        echo "# HELP servabo_sweeper_last_exit_code Exit status of the last run."
        echo "# TYPE servabo_sweeper_last_exit_code gauge"
        echo "servabo_sweeper_last_exit_code{sweeper=\"${NAME}\"} ${STATUS}"
        echo "# HELP servabo_sweeper_last_duration_seconds Wall-clock duration of the last run."
        echo "# TYPE servabo_sweeper_last_duration_seconds gauge"
        echo "servabo_sweeper_last_duration_seconds{sweeper=\"${NAME}\"} ${DURATION}"
        if [[ "${OUTCOME}" == "ok" ]]; then
            echo "# HELP servabo_sweeper_last_success_timestamp_seconds Unix time of the last successful run."
            echo "# TYPE servabo_sweeper_last_success_timestamp_seconds gauge"
            echo "servabo_sweeper_last_success_timestamp_seconds{sweeper=\"${NAME}\"} ${FINISHED_AT}"
        elif [[ -f "${TEXTFILE_DIR}/servabo_sweeper_${NAME}.prom" ]]; then
            grep '^servabo_sweeper_last_success_timestamp_seconds' \
                "${TEXTFILE_DIR}/servabo_sweeper_${NAME}.prom" 2>/dev/null || true
        fi
    } > "${TMP}"
    chmod 644 "${TMP}"
    mv "${TMP}" "${TEXTFILE_DIR}/servabo_sweeper_${NAME}.prom"
fi

if [[ -n "${HEARTBEAT_BASE:-}" && -n "${HEARTBEAT}" ]]; then
    if [[ "${OUTCOME}" == "ok" ]]; then
        URL="${HEARTBEAT_BASE}/${HEARTBEAT}"
    else
        URL="${HEARTBEAT_BASE}/${HEARTBEAT}/fail"
    fi
    curl -fsS -m 10 --retry 3 --retry-delay 2 -o /dev/null "${URL}" \
        || echo "HEARTBEAT_PING_FAILED | ${NAME} | ${URL}" >> "${LOG_FILE}"
fi

echo "SWEEP_WRAPPER_DONE | ${NAME} | status=${STATUS} outcome=${OUTCOME} duration=${DURATION}s" \
    >> "${LOG_FILE}"

exit "${STATUS}"