# ==========================
# History
# ==========================
.history/

# ARCH-0V finding B-1 — database dumps and generated SQL must never be tracked.
# backup_pre_alignment.sql was a readable pg_dump in a public repository
# containing four bcrypt password hashes and three real email addresses.
# Gate 0V-G6 enforces this; these patterns stop it happening by accident.
*.dump
*.backup
*.bak
backup_*.sql
expand.sql
contract.sql
flowpilot-*.sql

# Environment files
.env
.env.*
!.env.example
!.env.*.example
backend/.env.production
backend/.env.production.*
# Environment files - never commit credentials

# Local development runtime files
.dev/

# ARCH-40 apply backup
**/.arch40_apply_backup/

# ARCH41-S1:gitignore. ARCH-41 apply backups, and the encrypted database
# backups the backup floor writes. Encrypted or not, a database backup has no
# place in a public repository (see ARCH-0V finding B-1 above).
**/.arch41_apply_backup/
# ARCH42-S1:gitignore. ARCH-42 apply backups.
**/.arch42_apply_backup/
# ARCH43-S1:gitignore. ARCH-43 apply backups.
**/.arch43_apply_backup/
# ARCH44-S1:gitignore. ARCH-44 apply backups.
**/.arch44_apply_backup/
# ARCH45-S1:gitignore. ARCH-45 apply backups.
**/.arch45_apply_backup/
.flowpilot_backups/
**/.flowpilot_backups/
*.fpbk
*.fpbk.partial

