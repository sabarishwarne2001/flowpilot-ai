# ==============================================================================
# FlowPilot AI - Global Environment Configurations Template (SaaS Hardened)
# ==============================================================================

# --- Project Metadata ---
PROJECT_NAME="FlowPilot AI"
ENVIRONMENT="development"  # Options: development, staging, production
API_V1_STR="/api/v1"

# --- Server Runtime Settings ---
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# --- Security & CORS Settings ---
# Provide a comma-separated list of allowed origins.
# For local development with a frontend: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# --- Database Infrastructure Settings (PostgreSQL) ---
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password_here"
POSTGRES_DB="flowpilot"

# --- Authentication & Cryptography Settings ---
# Security Warning: Generate a secure 32 or 64-character hexadecimal key for production use.
# Example command: openssl rand -hex 32
# REQUIRED. No default exists in code. Generate per environment and never commit:
#   openssl rand -hex 32
# The value previously placed here was published and is permanently rejected.
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- File Ingestion & Storage Settings ---
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE=104857600  # 100 MB in bytes
# Provide a JSON array string representing allowed MIME types
ALLOWED_MIME_TYPES='["application/pdf", "image/png", "image/jpeg", "image/jpg"]'

# --- AI Processing & LLM Gateways ---
LLM_PROVIDER="groq"  # Supported drivers: "groq", "gemini"
GROQ_API_KEY="gsk_your_groq_api_key_goes_here"
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_goes_here"
GROQ_MODEL_NAME="llama-3.3-70b-versatile"
GEMINI_MODEL_NAME="gemini-3.5-flash"

# --- Text Chunking & Embedding Model Settings ---
CHUNK_SIZE=750
CHUNK_OVERLAP=150
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_BATCH_SIZE=32

# --- Vector Store (ChromaDB) Settings ---
CHROMA_PERSIST_DIRECTORY="chromadb"
CHROMA_COLLECTION_NAME="flowpilot_chunks"
CHROMA_TELEMETRY_ENABLED=False
CHROMA_ALLOW_RESET=False

# --- OCR Settings ---
OCR_LANGUAGE="en"

# --- Application Origin ---
# Where the user-facing frontend is served. Identity email links are built
# against this value. Must be HTTPS outside development.
FRONTEND_URL="http://localhost:3000"

# --- Platform SMTP (identity email: verification, password reset) ---
# Sends on behalf of FlowPilot, to users who may have no workspace.
# Tenant-generated mail continues to use per-workspace SMTP from the database.
# On a hosted relay the login username is not an address: SendGrid uses
# "apikey", Mailgun uses "postmaster@mg.yourdomain.com". Set the visible
# sender separately below.
PLATFORM_SMTP_HOST="smtp.yourprovider.com"
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USERNAME="apikey"
PLATFORM_SMTP_PASSWORD="platform_relay_password_here"
PLATFORM_SMTP_ENCRYPTION="TLS"   # NONE | TLS | SSL
PLATFORM_SMTP_FROM_EMAIL="noreply@flowpilot.ai"
PLATFORM_SMTP_FROM_NAME="FlowPilot AI"

# --- SMTP Password Encryption ---
# Encryption key used to protect stored SMTP credentials
EMAIL_ENCRYPTION_KEY="your_secure_32_character_encryption_key_here"

# --- AI Assistant & RAG Parameter Settings ---
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.20
RAG_MAX_CONTEXT_LENGTH=15000
MAX_CONVERSATION_MESSAGES=10