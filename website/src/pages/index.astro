---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import SectionHead from "../components/SectionHead.astro";
import PlanBadge from "../components/PlanBadge.astro";
import ClosingCta from "../components/ClosingCta.astro";
import engines from "../data/engines.json";
import { APP, SITE, absolute } from "../config/site";
import { PLANS, TRIAL_DAYS, dollars, plan } from "../lib/pricing";

const business = plan("business");

const pains = [
  "We paid an invoice above the price on the purchase order, and found out at the audit.",
  "The same invoice arrived by email and by post, and we paid it twice.",
  "A supplier's bank account changed on one invoice and nobody noticed.",
  "A contract renewed itself because nobody saw the notice period.",
  "We pay small suppliers late without knowing the law sets a deadline.",
  "Month-end means a week of matching statements to our books by hand.",
];

const steps = [
  {
    n: "01",
    title: "Bring the documents you already have",
    body: "Upload invoices, orders, delivery notes, contracts, certificates and bank or supplier statements, or let your systems send them through the API. Suppliers can send missing documents through a link you share.",
  },
  {
    n: "02",
    title: "Servabo reads them and checks them against each other",
    body: "Every field is read with the page it came from. Invoices are matched to orders and receipts, duplicates and changed bank details are flagged, and each promise (what is owed, by whom, by when) lands in one ledger.",
  },
  {
    n: "03",
    title: "You decide; Servabo keeps it true",
    body: "Approve what Servabo proposes: pay this on Tuesday, hold that, chase this customer. Nothing moves money by itself, and every step is recorded with its evidence.",
  },
];

const controls = [
  { title: "Your data stays yours", body: "Each organization's documents are isolated from every other's. Tests that try another organization's identifiers against the API run on every change to the code." },
  { title: "Roles that mean something", body: "Owners, admins, billing managers and members at the organization; admins, contributors and viewers per workspace. The server checks every request." },
  { title: "An audit log no one can edit", body: "Every sensitive change is recorded. The database itself refuses to change or delete an entry." },
  { title: "Secrets encrypted at rest", body: "Keys, passwords and tokens you give Servabo are encrypted with rotating keys; API keys are stored only as keyed hashes." },
  { title: "Sign-in on your terms", body: "Two-factor authentication, organization-wide sign-in policies and, on Enterprise, SAML or OIDC single sign-on with SCIM." },
  { title: "AI that reads, not decides", body: "Models read and draft. Rules, checks and approvals are deterministic code and people; Helm works with AI switched off." },
];

const faqs = [
  {
    q: "What do I need to start?",
    a: `An email address. The ${TRIAL_DAYS}-day trial needs no payment details: upload a few of your own documents and see what Servabo reads. When the trial ends your data stays readable; subscribe to keep working.`,
  },
  {
    q: "Does Servabo pay suppliers for me?",
    a: "No. Servabo plans what to pay, hold and chase and checks each step against your rules; a person approves, and your team pays from its own bank. Import your bank statement and Servabo matches the payments back to the invoices.",
  },
  {
    q: "Which documents and languages does it read?",
    a: "PDFs (with or without a text layer), scans and photos of invoices, purchase orders, goods receipts, credit notes, contracts, certificates and statements, in English. India is a first focus: amounts in rupees, GST invoices, and the MSMED Act's payment deadlines in Helm; any currency works.",
  },
  {
    q: "Is my data used to train AI models?",
    a: "Servabo does not use your documents to train AI models. Document text is sent to the AI provider named on our subprocessors page only to read it for you, and the answer comes back to your workspace.",
  },
  {
    q: "Who is behind Servabo?",
    a: `Servabo is built and run by ${SITE.operator.name}, an independent founder in ${SITE.operator.country}. Write to ${SITE.contactEmail}; you get an answer within ${SITE.responseTime}.`,
  },
];

const softwareApplication = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web browser",
  url: SITE.url,
  description: SITE.description,
  offers: PLANS.filter((p) => p.monthly > 0).map((p) => ({
    "@type": "Offer",
    name: p.name,
    price: (p.monthly / 100).toFixed(2),
    priceCurrency: "USD",
    url: absolute("/pricing"),
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      price: (p.monthly / 100).toFixed(2),
      priceCurrency: "USD",
      unitText: "per seat per month",
      billingDuration: "P1M",
    },
  })),
};
---
<Base title={SITE.name} description={`${SITE.tagline} Servabo reads, matches and tracks every invoice, order, contract and statement, and plans what to pay, hold and chase.`} structuredData={[softwareApplication]}>
  <!-- Hero -->
  <section class="relative overflow-hidden" aria-labelledby="hero-title">
    <div class="grid-paper pointer-events-none absolute inset-x-0 top-0 h-[38rem]" aria-hidden="true"></div>
    <div class="page relative pb-10 pt-16 sm:pt-24">
      <div class="mx-auto max-w-4xl text-center">
        <p class="eyebrow reveal">Servabo · Latin for “I will keep”</p>
        <h1 id="hero-title" class="display reveal mt-5">{SITE.tagline}</h1>
        <p class="lede reveal reveal-delay mx-auto mt-6 max-w-2xl">
          Servabo reads every invoice, order, receipt, contract and statement your team receives,
          checks them against each other, and keeps the promises in them: what you owe, what you
          are owed, and by when.
        </p>
        <div class="reveal reveal-delay mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <a href={APP.register} class="btn-primary">Start free trial</a>
          <a href={APP.signIn} class="btn-quiet">Sign in</a>
        </div>
        <p class="mt-4 text-sm text-muted-foreground">{TRIAL_DAYS}-day trial · no card needed · online software, available immediately after sign-up</p>
      </div>
      <div class="reveal reveal-delay mx-auto mt-14 max-w-6xl">
        <Shot name="helm-cockpit" tone="helm" eager alt="Servabo's Helm cockpit for a sample company: instruments for each rule, the cash flight path for the coming weeks, and the plan of payments to approve." />
        <p class="mt-3 text-center text-xs text-muted-foreground">The Helm cockpit on Servabo's sample company, Meridian Wholesale (an invented distributor). Screenshot of the product.</p>
      </div>
    </div>
  </section>

  <!-- The problem -->
  <section class="page mt-24" aria-labelledby="problem">
    <SectionHead eyebrow="Sound familiar?" title="The promises in your documents are kept by memory and spreadsheets." id="problem" lede="Every invoice, order and contract makes a promise: a price, a date, a quantity, a notice period. When nobody checks them against each other, money leaks quietly." />
    <ul class="mt-10 grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
      {pains.map((pain) => (
        <li class="bg-card p-6 text-[0.98rem] leading-relaxed text-foreground">
          <span class="mb-3 block font-mono text-xs text-muted-foreground" aria-hidden="true">✕</span>{pain}
        </li>
      ))}
    </ul>
  </section>

  <!-- How it works -->
  <section class="page mt-28" aria-labelledby="how">
    <SectionHead eyebrow="How it works" title="Three steps, and the second one is ours." id="how" />
    <ol class="mt-10 grid gap-6 lg:grid-cols-3">
      {steps.map((s) => (
        <li class="sheet-fold p-7">
          <span class="figure text-sm text-primary dark:text-[hsl(var(--primary-on-dark))]">{s.n}</span>
          <h3 class="h3 mt-4">{s.title}</h3>
          <p class="mt-3 leading-relaxed text-muted-foreground">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Flagship: Helm -->
  <section class="mt-28 border-y border-border bg-sidebar py-20" aria-labelledby="helm">
    <div class="page grid items-center gap-12 lg:grid-cols-[1fr_1.25fr]">
      <div>
        <p class="eyebrow">The flagship engine</p>
        <h2 id="helm" class="h2 mt-3">Helm keeps your business promises.</h2>
        <p class="lede mt-5">
          Write the outcomes and limits once: never pay above the agreed price, keep cash above
          your floor, pay micro and small suppliers within 45 days. Helm reads every promise in
          your documents, plans what to pay, hold and chase, and checks every step against your
          rules before you see it.
        </p>
        <ul class="mt-7 space-y-3 text-[0.98rem]">
          <li class="ledger-row"><span>Every action carries a certificate with each check and its evidence</span><span class="figure text-success">✓</span></li>
          <li class="ledger-row"><span>Starts in Propose mode: Helm proposes, a person approves</span><span class="figure text-success">✓</span></li>
          <li class="ledger-row"><span>Replay your last months as if Helm had been on</span><span class="figure text-success">✓</span></li>
          <li class="ledger-row"><span>Never moves money: the payment run is a list your team pays</span><span class="figure text-success">✓</span></li>
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/helm" class="btn-primary">Explore Helm</a>
          <span class="text-sm text-muted-foreground">Full Helm on {business.name} and up; a preview on every plan.</span>
        </div>
      </div>
      <Shot name="helm-certificate" tone="helm" alt="The Guard certificate for one payment in Helm's plan: every check with an icon for its result, and a seal engraved with the start of its fingerprint." />
    </div>
  </section>

  <!-- Engines by job -->
  <section class="page mt-28" aria-labelledby="engines">
    <SectionHead eyebrow="Everything it does" title="Engines grouped by the job they do." id="engines" lede="Start with reading and matching; add Helm, obligations and ERP posting as your team grows into them." />
    <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {engines.groups.map((g) => (
        <article class="sheet flex flex-col p-7">
          <h3 class="h3">{g.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{g.lede}</p>
          <ul class="mt-5 flex-1 space-y-3">
            {g.engines.map((e) => (
              <li class="flex items-start justify-between gap-3 border-t border-dashed border-border pt-3">
                <span class="text-[0.95rem] font-medium">{e.name}</span>
                <PlanBadge feature={e.capability} />
              </li>
            ))}
          </ul>
          <a href={`/product#${g.id}`} class="link mt-6 text-sm">See {g.title.toLowerCase()} in the product tour</a>
        </article>
      ))}
      <article class="sheet flex flex-col justify-between bg-primary p-7 text-primary-foreground">
        <div>
          <h3 class="text-lg font-semibold">Not sure where to start?</h3>
          <p class="mt-2 text-sm leading-relaxed">The solution pages walk through the jobs of accounts payable, procurement, legal and operations teams.</p>
        </div>
        <a href="/solutions/accounts-payable" class="mt-6 inline-flex font-semibold underline underline-offset-4">Solutions by team</a>
      </article>
    </div>
  </section>

  <!-- Security -->
  <section class="page mt-28" aria-labelledby="security">
    <SectionHead eyebrow="Security and control" title="Built for the documents finance teams cannot afford to leak." id="security" lede="What is listed here is what the product does today. We hold no certifications yet, and say so." />
    <div class="mt-10 grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
      {controls.map((c) => (
        <div class="bg-card p-6">
          <h3 class="font-semibold">{c.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{c.body}</p>
        </div>
      ))}
    </div>
    <a href="/security" class="link mt-6 inline-block text-sm">How Servabo protects your data</a>
  </section>

  <!-- Pricing teaser -->
  <section class="page mt-28" aria-labelledby="pricing-teaser">
    <SectionHead eyebrow="Pricing" title="Per seat, per month. Every price on this page is the price you pay." id="pricing-teaser" />
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {PLANS.map((p) => (
        <a href="/pricing" class={`sheet block p-6 transition-shadow hover:shadow-elevation-2 ${p.key === "business" ? "ring-2 ring-primary" : ""}`}>
          <p class="font-semibold">{p.name}</p>
          <p class="mt-3">
            <span class="figure text-3xl font-semibold">{p.monthly ? dollars(p.monthly) : "$0"}</span>
            <span class="text-sm text-muted-foreground">{p.monthly ? " per seat / month" : ` for ${TRIAL_DAYS} days`}</span>
          </p>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{p.for}</p>
        </a>
      ))}
    </div>
    <p class="mt-4 text-sm text-muted-foreground">Prices exclude taxes; {SITE.merchantOfRecord}, our merchant of record, calculates and collects tax at checkout. <a href="/pricing" class="link">Compare plans</a></p>
  </section>

  <!-- FAQ -->
  <section class="page mt-28" aria-labelledby="faq">
    <SectionHead eyebrow="Questions" title="Asked before signing up." id="faq" />
    <div class="mt-8 max-w-3xl divide-y divide-border border-y border-border">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="figure text-muted-foreground transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-muted-foreground">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <ClosingCta />
</Base>
