# =============================================================================
# FlowPilot AI — production environment template.
#
#   cp .env.production.template .env.production
#   chmod 600 .env.production
#   # fill in every value marked REQUIRED, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production config
#
# `config` renders the merged file and fails loudly on any REQUIRED variable
# you missed, because docker-compose.prod.yml declares them with the
# ${VAR:?message} form. Run it before `up -d`, not after.
#
# Never commit this file. backend/.gitignore covers .env but confirm
# .env.production is matched before you write secrets into it.
# =============================================================================

# --- 1. Identity of this deployment ------------------------------------------
ENVIRONMENT=production
IMAGE_TAG=latest
LOG_LEVEL=INFO

# REQUIRED. The hostname Caddy serves and requests a certificate for.
APP_DOMAIN=app.example.com

# REQUIRED. Where Let's Encrypt sends expiry warnings. A real inbox.
ACME_CONTACT_EMAIL=ops@example.com

# REQUIRED. Must match APP_DOMAIN with scheme. Used for invitation links,
# password reset links and the Stripe return URL. A mismatch produces
# invitation emails whose links land on the wrong host.
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# --- 2. Database --------------------------------------------------------------
# REQUIRED. Not 'postgres'. Not 'flowpilot'.
POSTGRES_USER=flowpilot
# REQUIRED. openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=flowpilot

# Optional read replica. Leave blank for single-node; the reader engine then
# points at the writer and every route behaves as before.
DATABASE_REPLICA_URL=
DATABASE_REPLICA_ENFORCE_READ_ONLY=true

# --- 3. Cryptographic material ------------------------------------------------
# Every value below is REQUIRED and must be generated fresh for this
# deployment. Reusing a development key in production is the single most
# common way a solo deployment leaks every stored tenant credential at once.

# openssl rand -hex 32
# Rotating this invalidates every access token and refresh-token family.
JWT_SECRET_KEY=

# openssl rand -hex 32
# Rotating this invalidates every issued API key. There is no rehash path.
API_KEY_PEPPER=

# openssl rand -hex 32
REDIS_IDENTITY_PEPPER=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated, NEWEST KEY FIRST. MultiFernet decrypts with any key in the
# list and encrypts with the first. To rotate: prepend a new key, redeploy,
# run the re-encryption sweeper, then drop the old key on a later deploy.
# Removing a key before re-encryption permanently destroys every secret
# encrypted under it — stored SMTP passwords, BYOK provider keys, SAML
# certificates.
EMAIL_ENCRYPTION_KEYS=

# openssl rand -hex 32
# Shared between the API and the reranker sidecar.
RERANKER_INTERNAL_TOKEN=
RERANKER_ENABLED=true

# --- 4. Object storage --------------------------------------------------------
# s3 | r2 | minio. Prefer a managed provider: a single VPS disk is not
# durable storage for tenant documents.
STORAGE_BACKEND=s3

# REQUIRED.
S3_BUCKET=flowpilot-prod
S3_REGION=us-east-1

# Leave blank for AWS S3. Set for R2, B2 or self-hosted MinIO, e.g.
#   R2:    https://<account-id>.r2.cloudflarestorage.com
#   MinIO: http://minio:9000
S3_ENDPOINT_URL=

# REQUIRED. These are read by app/core/config.py as of RH-1. The AWS_*
# spellings are still accepted as aliases, but prefer the canonical names.
# Scope the IAM policy to this bucket only — s3:GetObject, s3:PutObject,
# s3:DeleteObject, s3:ListBucket. Nothing else.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# ARCH-20 data residency. Region -> bucket. A tenant pinned to a region with
# no entry here is REFUSED at write time rather than falling back to
# S3_BUCKET, which would place EU-resident data outside the EU.
#   S3_REGIONAL_BUCKETS={"EU":"flowpilot-eu","US":"flowpilot-us"}
S3_REGIONAL_BUCKETS={}

# --- 5. Ingress ---------------------------------------------------------------
# Caddy adds exactly one hop. Leave CONFIRMED false until you have verified
# the header end to end from a real external client; until then tenants
# cannot enable IP pinning, which is the correct failure direction.
TRUSTED_PROXY_HOPS=1
TRUSTED_PROXY_HOPS_CONFIRMED=false

# --- 6. Stripe ----------------------------------------------------------------
# Live keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Comma-separated. Add the new secret BEFORE rotating in the Stripe
# dashboard and remove the old one after, so no event is rejected mid-swap.
# Endpoint: https://app.example.com/api/v1/billing/webhooks/stripe
# Subscribe to: checkout.session.completed, customer.subscription.*,
# invoice.*, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRETS=

# Set true ONLY with live keys. With test keys and true, the reconciler
# accepts test-mode events as real revenue.
STRIPE_LIVEMODE=false

BILLING_DEFAULT_CURRENCY=USD
BILLING_SEAT_SYNC_ENABLED=true
BILLING_SEAT_PRORATION_BEHAVIOR=create_prorations
BILLING_REAUTH_REQUIRED=true

# --- 7. Transactional email ---------------------------------------------------
# Without this, invitations, verification links and password resets are
# generated and never delivered. The failure is silent from the UI.
PLATFORM_SMTP_HOST=smtp.postmarkapp.com
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_ENCRYPTION=TLS
PLATFORM_SMTP_FROM_EMAIL=noreply@example.com
PLATFORM_SMTP_FROM_NAME=FlowPilot AI

# --- 8. White-label custom domains (ARCH-25) ---------------------------------
# Leave false until DNS and the Caddy ask endpoint are both verified.
CUSTOM_DOMAINS_ENABLED=false
PLATFORM_RESERVED_HOSTS=["example.com","app.example.com","api.example.com"]
CUSTOM_DOMAIN_CHALLENGE_TTL_HOURS=168
CUSTOM_DOMAIN_MAX_PER_ORG=10
TLS_RENEWAL_WINDOW_DAYS=30
TLS_DEAD_MAN_DAYS=7
ACME_AGENT_URL=

# --- 9. Metering safety switch ------------------------------------------------
# NEVER false outside automated tests. False means the platform serves
# inference and bills nothing.
LLM_METERING_ENABLED=true

# --- 10. Bootstrap ------------------------------------------------------------
# Consumed once by scripts/seed_admin.py on first deploy, then remove both
# lines. seed_admin refuses the default development password when
# ENVIRONMENT=production, so this must be set to run the seeder at all.
SEED_ADMIN_EMAIL=founder@example.com
SEED_ADMIN_PASSWORD=
